{
  // Cloudflare Workers static-assets config. Build with `npm run build`, deploy with `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths so client-side routes like /c/phase-shift work on refresh.
    "not_found_handling": "single-page-application"
  },
  // Enables `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {}
}
